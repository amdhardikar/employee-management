{
	"name": "employee-management",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:preview": "vite preview --outDir reports/test",
		"coverage": "vitest run --coverage",
		"coverage:watch": "vitest --coverage",
		"coverage:preview": "vite preview --outDir reports/coverage",
		"responsive": "npm run build && node scripts/run-browser-test.mjs playwright.config.js",
		"responsive:preview": "vite preview --outDir reports/responsive/html",
		"performance:web-vitals": "npm run build && node scripts/run-browser-test.mjs playwright.web-vitals.config.js",
		"performance:lighthouse": "npm run build && node scripts/lighthouse-report.mjs",
		"performance:lighthouse:preview": "vite preview --outDir reports/lighthouse"
	},
	"dependencies": {
		"@fontsource/poppins": "^5.3.0",
		"@reduxjs/toolkit": "^2.12.0",
		"@tailwindcss/vite": "^4.3.3",
		"json-server": "^0.17.4",
		"lucide-react": "^1.24.0",
		"prop-types": "^15.8.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-redux": "^9.3.0",
		"react-router-dom": "^7.18.1",
		"tailwindcss": "^4.3.3",
		"web-vitals": "^6.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@playwright/test": "^1.62.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"concurrently": "^10.0.3",
		"eslint": "^9.25.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"jsdom": "^29.1.1",
		"lighthouse": "^12.8.2",
		"msw": "^2.15.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"vite": "^6.3.5",
		"vitest": "^4.1.10"
	}
}
